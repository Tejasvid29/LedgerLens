# apps/web's own env file — separate from the root .env (which apps/api
# reads). Since S12, the browser never calls apps/api directly, so nothing
# here needs a NEXT_PUBLIC_ prefix except the one line that's genuinely
# meant to be public (see below).
#
#   cp apps/web/.env.local.example apps/web/.env.local

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Create an OAuth 2.0 Client ID (Web application), authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google   (dev)
#   https://your-domain/api/auth/callback/google      (prod — add this too
#                                                       once you have one)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth's own session-cookie encryption — unrelated to API_AUTH_SECRET
# below. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# This deployment's canonical URL. Also what next.config.js derives the
# Server Actions same-origin allowlist from — see the comment there.
NEXTAUTH_URL="http://localhost:3000"

# Shared with the root .env's API_AUTH_SECRET — must match exactly.
API_AUTH_SECRET=""

# Server-only — the browser never calls apps/api directly. Point this at
# your deployed API's URL in production (e.g. the ALB/ECS URL from
# docs/deploy.md).
API_URL="http://localhost:3001"

# Sentry — optional. NEXT_PUBLIC_ here is deliberate (see
# sentry.client.config.ts): a DSN is designed to be public, unlike
# everything else in this file.
# NEXT_PUBLIC_SENTRY_DSN="https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX"
# SENTRY_AUTH_TOKEN="sntrys_..."   # only needed for source map upload
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="your-project-slug"
