# Root .env — read by apps/api's ConfigModule (see app.module.ts) and by
# docker-compose.yml. apps/web has its own env file: see
# apps/web/.env.local.example.
#
#   cp .env.example .env

# Database (docker-compose's postgres service by default — see
# docker-compose.yml for the matching user/password/db name)
DATABASE_URL="postgresql://ledgerlens:ledgerlens@localhost:5432/ledgerlens"

# Redis (docker-compose's redis service)
REDIS_URL="redis://localhost:6379"

# Alchemy (https://dashboard.alchemy.com/) — one key covers all 6 chains
ALCHEMY_API_KEY="your-alchemy-api-key"

# LLM provider behind InsightProvider (insights/insight-provider.interface.ts)
#   openai — real, billed calls. Needs OPENAI_API_KEY below.
#   stub   — free, deterministic, offline. Never set this outside apps/e2e's
#            own Playwright run (see apps/e2e/playwright.config.ts) — it's
#            not a real insight, just a mechanical summary of the input.
LLM_PROVIDER="openai"
OPENAI_API_KEY="your-openai-api-key"

# Chain data provider behind ChainProvider (chain/chain-provider.interface.ts)
#   alchemy — real chain data. This is the default if unset; leave this
#             line out entirely for normal dev/prod use.
#   fixture — canned deterministic transfers for one fixed test address,
#             zero live calls. Only ever set by apps/e2e/playwright.config.ts.
# CHAIN_PROVIDER="alchemy"

# S12 — service-to-service auth. apps/web mints a short-lived signed token
# proving a request came from an authenticated session (packages/shared/src
# /serviceToken.ts); apps/api verifies it here. Must match
# apps/web/.env.local's API_AUTH_SECRET exactly. Generate with:
#   openssl rand -base64 32
API_AUTH_SECRET="generate-with-openssl-rand--base64-32"

# CORS — apps/api only accepts requests from this origin (main.ts). Set to
# your deployed apps/web URL in production; defaults to
# http://localhost:3000 if unset, which is correct for local dev.
# CORS_ORIGIN="https://your-app.vercel.app"

# Sentry (apps/api side) — optional. Unset means Sentry.init() never runs
# (see src/sentry.ts) and nothing about error handling changes.
# SENTRY_DSN="https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX"
